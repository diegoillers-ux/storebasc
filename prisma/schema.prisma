generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USUARIOS ADMINISTRATIVOS ────────────────────────────
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      AdminRole @default(OPERATOR)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings  Booking[]
  orders    Order[]

  @@map("admin_users")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  READER
}

// ─── CLIENTES ────────────────────────────────────────────
model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  notes       String?
  source      String?  // instagram, facebook, referido, etc.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings    Booking[]
  orders      Order[]
  payments    Payment[]

  @@map("customers")
}

// ─── SERVICIOS ───────────────────────────────────────────
model Service {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  duration     Int      // minutos
  price        Float
  currency     String   @default("COP")
  modality     String   @default("whatsapp") // whatsapp | presencial | video
  preparation  String?  // instrucciones previas
  active       Boolean  @default(true)
  featured     Boolean  @default(false)
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings     Booking[]
  aiAssets     AiAsset[]

  @@map("services")
}

// ─── DISPONIBILIDAD ──────────────────────────────────────
model Availability {
  id          String   @id @default(cuid())
  dayOfWeek   Int?     // 0=Dom, 6=Sab; null = fecha específica
  specificDate DateTime?
  startTime   String   // HH:mm
  endTime     String   // HH:mm
  slotMinutes Int      @default(60)
  active      Boolean  @default(true)

  @@map("availability")
}

model BlockedSlot {
  id          String   @id @default(cuid())
  startAt     DateTime
  endAt       DateTime
  reason      String?
  createdAt   DateTime @default(now())

  @@map("blocked_slots")
}

// ─── RESERVAS ─────────────────────────────────────────────
model Booking {
  id              String        @id @default(cuid())
  customerId      String
  serviceId       String
  adminId         String?
  scheduledAt     DateTime
  durationMinutes Int
  status          BookingStatus @default(PENDING_PAYMENT)
  notes           String?
  calendarEventId String?
  whatsappLink    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer        Customer  @relation(fields: [customerId], references: [id])
  service         Service   @relation(fields: [serviceId], references: [id])
  admin           AdminUser? @relation(fields: [adminId], references: [id])
  payments        Payment[]
  events          BookingEvent[]

  @@map("bookings")
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_SUBMITTED    // comprobante enviado
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model BookingEvent {
  id          String   @id @default(cuid())
  bookingId   String
  type        String   // STATUS_CHANGE | NOTE | REMINDER_SENT | WHATSAPP_SENT
  description String
  createdAt   DateTime @default(now())

  booking     Booking  @relation(fields: [bookingId], references: [id])

  @@map("booking_events")
}

// ─── PAGOS ───────────────────────────────────────────────
model Payment {
  id            String        @id @default(cuid())
  customerId    String
  bookingId     String?
  orderId       String?
  method        PaymentMethod
  provider      String?       // wompi | epayco | manual
  amount        Float
  currency      String        @default("COP")
  status        PaymentStatus @default(PENDING)
  reference     String?       // referencia del proveedor
  receiptUrl    String?       // comprobante subido
  providerData  Json?         // respuesta completa del proveedor
  verifiedAt    DateTime?
  verifiedBy    String?       // id del admin que aprobó
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer      Customer  @relation(fields: [customerId], references: [id])
  booking       Booking?  @relation(fields: [bookingId], references: [id])
  order         Order?    @relation(fields: [orderId], references: [id])

  @@map("payments")
}

enum PaymentMethod {
  TRANSFER
  NEQUI
  DAVIPLATA
  CASH
  GATEWAY
}

enum PaymentStatus {
  PENDING
  SUBMITTED       // comprobante enviado, pendiente verificación
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
}

// ─── CATÁLOGO ─────────────────────────────────────────────
model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Float
  currency    String   @default("COP")
  stock       Int      @default(0)
  sku         String?  @unique
  category    String?
  imageUrl    String?
  images      String[] // urls adicionales
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems      OrderItem[]
  stockMovements  StockMovement[]
  aiAssets        AiAsset[]

  @@map("products")
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  change    Int      // positivo = entrada, negativo = salida
  reason    String   // venta | ajuste | devolución | inicial
  orderId   String?
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id])

  @@map("stock_movements")
}

// ─── PEDIDOS ──────────────────────────────────────────────
model Order {
  id          String      @id @default(cuid())
  customerId  String
  adminId     String?
  status      OrderStatus @default(NEW)
  subtotal    Float
  shipping    Float       @default(0)
  total       Float
  currency    String      @default("COP")
  delivery    String      @default("pickup") // pickup | shipping | local
  address     String?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer    Customer    @relation(fields: [customerId], references: [id])
  admin       AdminUser?  @relation(fields: [adminId], references: [id])
  items       OrderItem[]
  payments    Payment[]
  events      OrderEvent[]

  @@map("orders")
}

enum OrderStatus {
  NEW
  PAYMENT_PENDING
  PAYMENT_SUBMITTED
  PAID
  PREPARING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float
  total     Float

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  type        String
  description String
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id])

  @@map("order_events")
}

// ─── CREATIVIDADES IA ─────────────────────────────────────
model AiAsset {
  id          String      @id @default(cuid())
  serviceId   String?
  productId   String?
  format      String      // story | post | banner | card
  prompt      String
  imageUrl    String
  status      AssetStatus @default(PENDING_REVIEW)
  approvedAt  DateTime?
  approvedBy  String?
  createdAt   DateTime    @default(now())

  service     Service?  @relation(fields: [serviceId], references: [id])
  product     Product?  @relation(fields: [productId], references: [id])

  @@map("ai_assets")
}

enum AssetStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

# ─── Base de datos ───────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/anandastore"

# ─── Autenticación (NextAuth v5) ─────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate_with_openssl_rand_base64_32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Google Calendar ─────────────────────────────────────
GOOGLE_CALENDAR_ID="tu_calendario@gmail.com"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# ─── Email (SMTP) ────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Espíritu Ananda <no-reply@espiritananda.com>"

# ─── WhatsApp ─────────────────────────────────────────────
WHATSAPP_NUMBER="573XXXXXXXXX"

# ─── Pagos ───────────────────────────────────────────────
# Pasarela (activar cuando aplique)
PAYMENT_PROVIDER="manual" # manual | wompi | epayco | payu
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_WEBHOOK_SECRET=""

# ─── Almacenamiento de archivos ───────────────────────────
STORAGE_PROVIDER="cloudinary" # cloudinary | s3
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── IA (Gemini) ──────────────────────────────────────────
GEMINI_API_KEY=""
GEMINI_MODEL="imagen-4-fast"

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="573XXXXXXXXX"
NEXT_PUBLIC_APP_NAME="Espíritu Ananda"

NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."   # Clave pública para el navegador
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."            # SOLO servidor (nunca exponer)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."            # Servidor: comprobantes privados

# ─── Modo de Operación & Pasarela de Pagos ──────────────────
NEXT_PUBLIC_DEMO_MODE="false"               # 'true' solo en entornos aislados; en producción se ignora (fail-closed)
